# Local environment overrides for the LLM type-annotation pipeline.
#
# Copy this file to local.env (gitignored), edit the paths, and source it
# from the repository root before running the pipeline:
#
#   cp local.env.example local.env
#   $EDITOR local.env
#   source local.env
#
# The pipeline does not read local.env automatically; sourcing it (or using
# an equivalent tool such as direnv) is what exports these values. The
# committed project_config.yaml and benchmarks.yaml need no edits for a
# normal local run.

# JDK 21 is required to build the pipeline. Target repositories still
# compile at the Java level declared in benchmarks.yaml.
export JAVA_HOME="/path/to/jdk-21"

# Optional: use a shared Gradle cache. Defaults to ~/.gradle.
# export GRADLE_USER_HOME="$HOME/.gradle"

# Checker Framework 3.42.0. Either install it at
# vendor/checker-framework-3.42.0/ and leave this unset, or point at it.
# Source this file from the repository root so $(pwd) is correct.
export CHECKERFRAMEWORK="$(pwd)/vendor/checker-framework-3.42.0"

# Optional: OpenCode global DB. The runner auto-detects
# ~/.local/share/opencode/opencode.db (Linux) and
# ~/Library/Application Support/opencode/opencode.db (macOS).
# export OPENCODE_GLOBAL_DB="/absolute/path/to/opencode.db"

# Optional: isolated per-run OpenCode DB. Defaults to
# data/opencode-agent-<pid>.db under the current working directory.
# export PIPELINE_OPENCODE_DB="/absolute/path/to/opencode-agent.db"

# Optional: scratch directory for agent workspaces. Defaults to
# ${java.io.tmpdir}/pipeline-scratch.
# export PIPELINE_SCRATCH_DIR="/tmp/pipeline-scratch"
