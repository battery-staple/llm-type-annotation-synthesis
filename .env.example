# Local environment overrides for the LLM type-annotation pipeline.
#
# Copy this file to .env (gitignored) and edit the values your machine needs:
#
#   cp .env.example .env
#   $EDITOR .env
#
# The pipeline reads .env automatically before loading project_config.yaml.
# It looks next to --config (usually the repository root), then in the working
# directory; set PIPELINE_ENV_FILE to use a different file.
#
# The file is parsed, not sourced: $VAR and $(...) are NOT expanded, so use
# absolute paths. Existing shell environment variables take precedence over
# this file. The committed project_config.yaml and benchmarks.yaml need no
# edits for a normal local run.
#
# Uncomment and set only the values your machine needs. Missing values fall
# back to the process environment and the defaults in project_config.yaml.

# JDK 21 for target-repository builds launched by the pipeline. The pipeline
# itself must already run on JDK 21, so keep JAVA_HOME set in your shell when
# building with ./gradlew.
# JAVA_HOME=/path/to/jdk-21

# Optional: use a shared Gradle cache. Defaults to ~/.gradle.
# GRADLE_USER_HOME=/absolute/path/to/gradle-user-home

# Checker Framework 3.42.0. Either install it at
# <repo>/vendor/checker-framework-3.42.0/ and leave this unset, or point at it.
# CHECKERFRAMEWORK=/absolute/path/to/llm-type-annotation-synthesis/vendor/checker-framework-3.42.0

# Optional: OpenCode global DB. The runner auto-detects
# ~/.local/share/opencode/opencode.db (Linux) and
# ~/Library/Application Support/opencode/opencode.db (macOS).
# OPENCODE_GLOBAL_DB=/absolute/path/to/opencode.db

# Optional: isolated per-run OpenCode DB. Defaults to
# data/opencode-agent-<pid>.db under the current working directory.
# PIPELINE_OPENCODE_DB=/absolute/path/to/opencode-agent.db

# Optional: scratch directory for agent workspaces. Defaults to
# <java.io.tmpdir>/pipeline-scratch.
# PIPELINE_SCRATCH_DIR=/tmp/pipeline-scratch
